---
import LinkGrid from "./LinkGrid.astro";
import type { LinkItem } from "@content/links";

interface Props {
  limit?: number;
}

const { limit } = Astro.props;

type GuideModule = {
  url: string;
  frontmatter: { title: string; description: string; date: string };
};

const guideFiles = import.meta.glob<GuideModule>("../../pages/learn/*.md", {
  eager: true,
});
const items: LinkItem[] = Object.values(guideFiles)
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).getTime() -
      new Date(a.frontmatter.date).getTime(),
  )
  .map(({ url, frontmatter }) => ({
    title: frontmatter.title,
    description: frontmatter.description,
    url,
  }));
---

<LinkGrid items={items} limit={limit} external={false} />
